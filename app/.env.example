# Supabase Cloud Configuration (Mumbai ap-south-1)
# Create a Supabase project and paste the URL and Anon Key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional external API URL (defaults to Supabase RPC when configured)
# NEXT_PUBLIC_API_URL=

# --- Invite-only user management (SERVER ONLY — never prefix these with NEXT_PUBLIC_) ---
# Supabase → Project Settings → API → service_role key. Lets the server create logins.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Who can open /admin (comma-separated). Sign in to the app with one of these.
ADMIN_EMAILS=you@example.com
# ADMIN_PHONES=9876543210
